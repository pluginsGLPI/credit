{% import "components/form/fields_macros.html.twig" as fields %}
{% set rand = random() %}

<div name="credit_consume_{{ rand }}">

    <div class="hr-text mt-2">
        <i class="fa-2x ti ti-coin"></i>
        <span>{{ type_name }}</span>
    </div>

    {{ fields.sliderField(
        'plugin_credit_consumed_voucher',
        consume,
        __('Consume a voucher ?', 'credit'),
        {
            'rand': rand,
        }
    ) }}

    <div id="creditvoucherblock{{ rand }}" style="display: {% if consume == 1 %}block{% else %}none{% endif %}">
        <div class="row">
            {{ fields.dropdownField(
                creditentityclass,
                'plugin_credit_entities_id',
                default_credit,
                __('Voucher name', 'credit'),
                {
                    'entity': entity_id,
                    'condition': condition,
                    'field_class': 'col-6 col-sm-6',
                    'rand': rand,
                }
            ) }}

            {{ fields.numberField(
                'plugin_credit_quantity',
                1,
                __('Quantity consumed', 'credit'),
                {
                    'entity': entity_id,
                    'condition': condition,
                    'max': default_credit_max,
                    'min': 1,
                    'disabled': not consume or not default_credit,
                    'helper': __('Maximum consumable quantity', 'credit') ~ ' : <b>' ~ default_credit_max,
                    'field_class': 'col-6 col-sm-6' ~ (not default_credit ? ' d-none' : ''),
                    'input_class': 'col-xxl-5',
                    'label_class': 'col-xxl-7',
                    'rand': rand,
                }
            ) }}
        </div>
    </div>

    <span hidden data-credit-consume-rand="{{ rand }}" data-credit-quantity-url="{{ path('plugins/credit/ajax/dropdownQuantity.php') }}"></span>
    {{ call('Html::script', ['/plugins/credit/js/ticket_credit.js', {'version': constant('PLUGIN_CREDIT_VERSION')}, false])|raw }}
</div>
